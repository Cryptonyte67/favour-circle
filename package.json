{
  "name": "favour-circle",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Post a favour to a circle of family, friends or neighbours. Get it done. Pay instantly. A Nimiq Pay Mini App.",
  "scripts": {
    "dev": "run-p dev:server dev:web",
    "dev:server": "wrangler dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "smoke": "bash scripts/smoke.sh",
    "db:local": "wrangler d1 execute favour-circle --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute favour-circle --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "npm-run-all": "^4.1.5",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.129.0"
  }
}
